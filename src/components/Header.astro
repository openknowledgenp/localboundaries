---
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const links = [
  { href: '/', label: 'Home' },
  { href: '/map/', label: 'Map' },
  { href: '/download/', label: 'Download' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/">
      <img src="/images/okf-nepal-logo.png" alt="Open Knowledge Foundation Nepal" class="site-brand-logo" />
      <span class="site-brand-divider"></span>
      <span class="site-brand-name">LocalBoundaries</span>
    </a>
    <nav class="site-nav">
      {links.map((link) => (
        <a class:list={['page-link', { active: isActive(link.href) }]} href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
